{
  "domain_name": "MerchandisingAnalysis",
  "domain_description": "Provides merchandising-specific business intelligence within Oracle Retail Insights.",
  "dimension_concepts": [
    {
      "name": "CustomerDimension",
      "label": "Customer",
      "description": "Represents customers in the system.",
      "attributes": [],
      "source": "Out of Scope"
    },
    {
      "name": "GeographyDimension",
      "label": "Location",
      "description": "Represents geographical locations in the system.",
      "attributes": [],
      "source": "In-Scope"
    },
    {
      "name": "ProductCategory",
      "label": "Product Category",
      "description": "Categories of products sold.",
      "attributes": [],
      "source": "In-Scope"
    },
    {
      "name": "OrganizationDimension",
      "label": "Organization",
      "description": "Represents the organizational hierarchy in the system.",
      "attributes": [],
      "source": "In-Scope"
    }
  ],
  "fact_concepts": [
    {
      "name": "SaleFact",
      "label": "Sale",
      "description": "Represents a sale transaction.",
      "metrics": [
        "amount",
        "quantity"
      ],
      "source": "In-Scope"
    },
    {
      "name": "MarkdownFact",
      "label": "Markdown",
      "description": "Represents markdown transactions.",
      "metrics": [
        "amount",
        "quantity"
      ],
      "source": "In-Scope"
    }
  ],
  "reference_concepts": [],
  "forbidden_patterns": [
    "CustomerAnalysis",
    "MarketBasketAnalysis",
    "Consumer",
    "Cluster",
    "Wholesale",
    "Inventory",
    "Supplier",
    "CustomerOrder"
  ],
  "domain_relationships": [
    {
      "from": "SaleFact",
      "to": "ProductCategory",
      "label": "belongsTo",
      "cardinality": "1:N"
    },
    {
      "from": "SaleFact",
      "to": "GeographyDimension",
      "label": "occursIn",
      "cardinality": "1:N"
    }
  ],
  "key_metrics": [
    "TotalRevenue",
    "UnitsSold",
    "MarkdownAmount",
    "MarkdownQuantity",
    "RegularPriceAmount",
    "PromotionPriceAmount",
    "ClearancePriceAmount"
  ],
  "filters_and_prompts": [
    {
      "filter_name": "RegionFilter",
      "implied_dimension": "GeographyDimension"
    },
    {
      "filter_name": "ProductCategoryFilter",
      "implied_dimension": "ProductCategory"
    }
  ]
}